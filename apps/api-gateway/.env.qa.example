# Copy to .env for the QA environment. Never commit a real .env file (already gitignored).
# Mirrors .env.example's structure exactly — QA is a low-cost cloud tier (Render/Neon/Upstash/
# Cloudinary), distinct from the AWS-hosted staging/production environments. See
# docs/deployment/qa-environment.md for how QA differs from staging.

# --- Core (required in every environment) ---
NODE_ENV=staging
PORT=3000
DATABASE_URL="postgresql://replace-with-neon-user:replace-with-neon-password@replace-with-neon-host/patheya_express_qa?sslmode=require"
REDIS_HOST=replace-with-upstash-endpoint
REDIS_PORT=6379
REDIS_TLS=true
REDIS_AUTH_TOKEN=replace-with-upstash-password
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
KAFKA_BROKER=localhost:9092

# --- Storage — only 'local' (writes to disk, default) or 'cloudinary' are supported ---
STORAGE_DRIVER=cloudinary
CLOUDINARY_CLOUD_NAME=replace-with-qa-cloudinary-cloud-name
CLOUDINARY_API_KEY=replace-with-qa-cloudinary-api-key
CLOUDINARY_API_SECRET=replace-with-qa-cloudinary-api-secret

# --- Restaurant bank account encryption (optional — required only once a bank account is created) ---
# BANK_ACCOUNT_ENCRYPTION_KEY=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=replace-with-qa-razorpay-test-key-id
RAZORPAY_KEY_SECRET=replace-with-qa-razorpay-test-key-secret

# --- CORS allowlist (LH1-09) — the deployed origin of each frontend app.
# In non-production NODE_ENV, common localhost dev ports are always allowed in addition to these. ---
CUSTOMER_APP_URL=https://replace-with-qa-customer-app-url
RESTAURANT_APP_URL=https://replace-with-qa-restaurant-app-url
ADMIN_APP_URL=https://replace-with-qa-admin-app-url
DELIVERY_APP_URL=https://replace-with-qa-delivery-app-url

# --- Password reset email (LH1-04) ---
# Any standard SMTP provider (SES, SendGrid SMTP, Postmark, etc.). Required for the
# forgot-password flow to actually deliver reset links — validated at point of use, not at boot,
# so environments that never trigger a password reset aren't blocked by it.
SMTP_HOST=replace-with-qa-smtp-host
SMTP_PORT=587
SMTP_USER=replace-with-qa-smtp-user
SMTP_PASS=replace-with-qa-smtp-password
SMTP_FROM="Patheya Express QA <no-reply@patheyaexpress.com>"

# --- Logging ---
LOG_TO_FILE=false
LOG_LEVEL=info
