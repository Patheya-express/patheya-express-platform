# Copy to .env for local development. Never commit a real .env file (already gitignored).
# See docs/deployment.md for the full explanation of each variable and how they're supplied
# in each environment (development / staging / production).

# --- Core (required in every environment) ---
NODE_ENV=development
PORT=3000
# Port 15432, not 5432: this targets Docker Compose's postgres container, which publishes on host
# port 15432 by default specifically to avoid colliding with a native PostgreSQL install (which
# commonly already owns 5432) — see infrastructure/docker/docker-compose.yml and
# frontend/tools/dev/DEVELOPMENT.md's "Why 15432, not 5432?". Only using scripts/start-dev.ps1's
# native-Postgres workflow instead of Docker Compose? Change this back to localhost:5432 to match
# your native install.
DATABASE_URL="postgresql://postgres:postgres@localhost:15432/patheya_express_db?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
KAFKA_BROKER=localhost:9092

# --- Storage — only 'local' (writes to disk, default) or 'cloudinary' are supported ---
STORAGE_DRIVER=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# --- Restaurant bank account encryption (optional — required only once a bank account is created) ---
# BANK_ACCOUNT_ENCRYPTION_KEY=

# --- Payments (Razorpay) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# --- CORS allowlist (LH1-09) — the deployed origin of each frontend app.
# In non-production NODE_ENV, common localhost dev ports are always allowed in addition to these. ---
CUSTOMER_APP_URL=http://localhost:4200
RESTAURANT_APP_URL=http://localhost:4201
ADMIN_APP_URL=http://localhost:4202
DELIVERY_APP_URL=http://localhost:4203

# This API's own public origin — allows Swagger UI (served by this same process at /api/docs) to
# call /api/v1/* without being rejected by the CORS allowlist above. Optional: only needed once
# this API is reachable at a non-localhost origin (local dev is already covered by the
# always-allowed localhost pattern).
# API_PUBLIC_URL=https://api.patheyaexpress.com

# Optional, comma-separated list of further origins to allow (a new preview environment, an
# internal tool, etc.) without a code change.
# EXTRA_ALLOWED_ORIGINS=https://tools.patheyaexpress.com,https://preview.patheyaexpress.com

# --- Super Admin bootstrap (AdminBootstrapService) ---
# All five are required for the bootstrap to run at all; if any is missing, bootstrap is skipped
# (logged, not thrown) and the app starts up normally regardless. There is no API endpoint that
# creates a SUPER_ADMIN — this is the only path, and it only runs once (idempotent, safe to leave
# set across every restart/redeploy).
# SUPER_ADMIN_EMAIL=superadmin@patheyaexpress.com
# SUPER_ADMIN_PASSWORD=replace-with-a-long-random-value
# SUPER_ADMIN_FIRST_NAME=Super
# SUPER_ADMIN_LAST_NAME=Admin
# SUPER_ADMIN_PHONE=+910000000000

# --- Password reset email (LH1-04) ---
# Any standard SMTP provider (SES, SendGrid SMTP, Postmark, etc.). Required for the
# forgot-password flow to actually deliver reset links — validated at point of use, not at boot,
# so environments that never trigger a password reset aren't blocked by it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Patheya Express <no-reply@patheyaexpress.com>"
