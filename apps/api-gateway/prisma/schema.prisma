  walletAmountUsed Decimal @default(0) @db.Decimal(10, 2)

  notes String?

  deliveryAddress String

  latitude Float?

  longitude Float?

  placedAt DateTime @default(now())

  deliveredAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  customer User @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  branch RestaurantBranch? @relation(fields: [branchId], references: [id])

  deliveryPartner User? @relation("DeliveryOrders", fields: [deliveryPartnerId], references: [id])

  address Address? @relation(fields: [addressId], references: [id])

  coupon Coupon? @relation(fields: [couponId], references: [id])

  couponRedemption CouponRedemption?

  items OrderItem[]

  statusHistory OrderStatusHistory[]

  deliveryAssignments DeliveryAssignment[]

  proofOtps DeliveryProofOtp[]

  walletTransactions WalletTransaction[]

  supportTickets SupportTicket[]

  @@unique([customerId, idempotencyKey])
  @@index([restaurantId])
  @@index([deliveryPartnerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([couponId])
  @@map("orders")
}

