generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  RESTAURANT_OWNER
  RESTAURANT_MANAGER
  DELIVERY_PARTNER
  SUPPORT_AGENT
  ADMIN
  SUPER_ADMIN
  /** Additive (see migration 20260718160000_add_dispatch_manager_role) — authorizes manual
   *  dispatch assignment (POST /admin/orders/:orderId/assign) alongside SUPER_ADMIN. */
  DISPATCH_MANAGER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  PHONE
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum RestaurantStatus {
  PENDING

  APPROVED

  REJECTED

  SUSPENDED
}

enum RestaurantStaffRole {
  OWNER

  CO_OWNER

  BRANCH_MANAGER

  KITCHEN_MANAGER

  FINANCE_MANAGER

  STAFF
}

enum RestaurantStaffStatus {
  INVITED

  ACTIVE

  REVOKED
}

enum RestaurantVerificationStage {
  DRAFT

  SUBMITTED

  DOCUMENT_REVIEW

  GST_VERIFICATION

  FSSAI_VERIFICATION

  BANK_VERIFICATION

  COMPLIANCE_REVIEW

  APPROVED

  REJECTED

  SUSPENDED
}

/**
 * ERPH-2B.1 — tracks the mandatory onboarding wizard's own progress, deliberately separate from
 * both RestaurantVerificationStage (the admin-side detailed review sub-state-machine) and
 * RestaurantStatus (pure operational status). CHANGES_REQUESTED in particular has no equivalent
 * anywhere else in the schema. UNDER_REVIEW/APPROVED/REJECTED here are kept in sync with
 * RestaurantVerificationStage by OnboardingVerificationListener reacting to the existing
 * verification events — this enum is not a second copy of that state, it is the
 * onboarding-wizard-facing projection of it (plus the wizard-only states DRAFT/IN_PROGRESS/
 * CHANGES_REQUESTED that verification has no concept of).
 */
enum OnboardingStatus {
  DRAFT

  IN_PROGRESS

  SUBMITTED

  UNDER_REVIEW

  CHANGES_REQUESTED

  APPROVED

  REJECTED
}

enum RestaurantDocumentType {
  GST

  FSSAI

  PAN

  TRADE_LICENSE

  FIRE_NOC

  SHOP_ESTABLISHMENT

  LIQUOR_LICENSE

  HALAL

  CANCELLED_CHEQUE

  PASSBOOK

  AADHAAR

  PAN_CARD

  RENTAL_AGREEMENT

  UTILITY_BILL

  OTHER
}

/**
 * Shared verification lifecycle for documents, GST, FSSAI, and bank accounts.
 */
enum VerificationStatus {
  PENDING

  UNDER_REVIEW

  VERIFIED

  REJECTED

  EXPIRED
}

enum BusinessType {
  PROPRIETORSHIP

  PARTNERSHIP

  LLP

  PRIVATE_LIMITED

  PUBLIC_LIMITED

  TRUST

  SOCIETY

  OTHER
}

enum ServiceChargeType {
  NONE

  FLAT

  PERCENTAGE
}

enum RestaurantMediaType {
  LOGO

  BANNER

  FRONT_VIEW

  EXTERIOR

  KITCHEN

  DINING

  INTERIOR

  SIGN_BOARD

  GALLERY

  VIDEO
}

enum OrderStatus {
  PENDING

  CONFIRMED

  PREPARING

  READY_FOR_PICKUP

  OUT_FOR_DELIVERY

  DELIVERED

  CANCELLED
}

enum PaymentStatus {
  PENDING

  PAID

  FAILED

  REFUNDED
}

enum DeliveryPartnerStatus {
  OFFLINE

  AVAILABLE

  ON_DELIVERY

  SUSPENDED
}

enum VehicleType {
  BIKE

  SCOOTER

  BICYCLE

  CAR

  ELECTRIC_VEHICLE
}

enum Gender {
  MALE

  FEMALE

  OTHER

  PREFER_NOT_TO_SAY
}

enum FuelType {
  PETROL

  DIESEL

  ELECTRIC

  CNG

  HYBRID
}

/**
 * EDPH-1 — the delivery-partner analog of RestaurantDocumentType. One generic enum for the long
 * tail of KYC/vehicle document types rather than N near-identical tables, exactly mirroring the
 * restaurant document system. SELFIE/BACKGROUND_VERIFICATION are manual-admin-review only — no
 * biometric/background-check vendor is integrated.
 */
enum DeliveryDocumentType {
  DRIVING_LICENSE

  AADHAAR

  PAN

  VEHICLE_RC

  VEHICLE_INSURANCE

  VEHICLE_FITNESS

  VEHICLE_POLLUTION

  PROFILE_PHOTO

  SELFIE

  BACKGROUND_VERIFICATION

  VEHICLE_PHOTO

  OTHER
}

/**
 * EDPH-1 — deliberately simpler than RestaurantVerificationStage: no granular per-category
 * sub-stages (DOCUMENT_REVIEW/BANK_VERIFICATION/etc.) because delivery documents are reviewed
 * atomically per-document via the Documents API rather than via sequential category gates.
 * CHANGES_REQUESTED lives only on DeliveryOnboardingStatus, exactly like the Restaurant split.
 */
enum DeliveryVerificationStage {
  DRAFT

  SUBMITTED

  UNDER_REVIEW

  APPROVED

  REJECTED

  SUSPENDED
}

/**
 * EDPH-1 — exact mirror of OnboardingStatus, scoped to the delivery-partner wizard.
 */
enum DeliveryOnboardingStatus {
  DRAFT

  IN_PROGRESS

  SUBMITTED

  UNDER_REVIEW

  CHANGES_REQUESTED

  APPROVED

  REJECTED
}

enum ComplianceOverallStatus {
  COMPLIANT

  AT_RISK

  NON_COMPLIANT
}

enum AuditAction {
  CREATE

  UPDATE

  DELETE

  LOGIN

  LOGOUT

  STATUS_CHANGE

  APPROVE

  REJECT
}

enum NotificationType {
  ORDER_PLACED
  ORDER_STATUS_CHANGED
  DELIVERY_PARTNER_ASSIGNED
  OFFER
  WALLET_CREDIT
  REFERRAL_REWARD
  TICKET_STATUS_CHANGED
  TICKET_MESSAGE
  REVIEW_REPLIED
  GENERAL

  /**
   * Restaurant-facing notification types (ERPH-2A) — sent to restaurant owners/active staff
   * rather than customers. Kept in the same enum as the customer-facing types above since both
   * sides share one Notification table/user-scoped delivery model.
   */
  NEW_ORDER_FOR_RESTAURANT
  ORDER_CANCELLED_FOR_RESTAURANT
  REFUND_FOR_RESTAURANT
  CUSTOMER_MESSAGE_FOR_RESTAURANT

  /**
   * Delivery-partner-facing notification types (EDPH-1) — mirrors the restaurant-facing
   * additions above, same shared Notification table/user-scoped delivery model.
   */
  DELIVERY_PARTNER_VERIFICATION_SUBMITTED
  DELIVERY_PARTNER_VERIFICATION_APPROVED
  DELIVERY_PARTNER_VERIFICATION_REJECTED
  DELIVERY_PARTNER_CHANGES_REQUESTED
  DELIVERY_PARTNER_DOCUMENT_EXPIRING

  /**
   * Delivery Proof & Trust (Sprint 4.1) — pickup/delivery OTP lifecycle. The GENERATED types go
   * to the customer (who reads the code to their delivery partner); the VERIFIED types go to the
   * delivery partner (confirmation their entered code was accepted).
   */
  PICKUP_OTP_GENERATED
  DELIVERY_OTP_GENERATED
  PICKUP_VERIFIED
  DELIVERY_VERIFIED
}

enum OfferType {
  PERCENTAGE_OFF
  FLAT_OFF
  FREE_DELIVERY
  BUY_ONE_GET_ONE
  CASHBACK
  OTHER
}

enum CouponType {
  PERCENTAGE
  FLAT
  FREE_DELIVERY
}

enum CouponScope {
  PLATFORM
  RESTAURANT
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum PaymentProvider {
  RAZORPAY

  STRIPE
}

enum PaymentMethod {
  UPI

  CARD

  NETBANKING

  WALLET

  COD
}

enum PaymentMode {
  ONLINE

  COD
}

/**
 * How a location's coordinates were captured — surfaced in the Address Preview / audit trail,
 * never used for authorization.
 */
enum LocationSource {
  GPS

  MANUAL

  AUTOCOMPLETE

  REVERSE_GEOCODE

  MAP_CLICK

  MARKER_DRAG
}

/**
 * Which AddressProvider implementation resolved this location — lets the backend validate/
 * audit coordinates without caring which map SDK the frontend used.
 */
enum MapProvider {
  GOOGLE_MAPS

  MAPBOX

  HERE_MAPS

  OPENSTREETMAP

  AZURE_MAPS
}

enum AddressLabel {
  HOME

  WORK

  OTHER
}

enum TransactionStatus {
  PENDING

  SUCCESS

  FAILED

  REFUNDED
}

enum AssignmentStatus {
  PENDING

  ASSIGNED

  ACCEPTED

  REJECTED

  EXPIRED
}

enum WalletTransactionType {
  CASHBACK
  REFERRAL_REWARD
  REFUND_CREDIT
  ORDER_PAYMENT
  ADMIN_ADJUSTMENT
}

enum WalletTransactionStatus {
  COMPLETED
  REVERSED
}

enum ReferralStatus {
  PENDING
  REWARDED
}

enum TicketCategory {
  ORDER_ISSUE
  PAYMENT_ISSUE
  REFUND_REQUEST
  CANCELLATION_REQUEST
  ACCOUNT_ISSUE
  GENERAL
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketMessageSenderType {
  CUSTOMER
  AGENT
  SYSTEM
}

model User {
  id String @id @default(uuid())

  firstName String
  lastName  String?

  email String? @unique
  phone String? @unique

  passwordHash String?

  role   UserRole
  status UserStatus @default(ACTIVE)

  provider AuthProvider @default(EMAIL)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)

  lastLoginAt DateTime?

  avatarUrl String?

  preferredLanguage String @default("en")

  themePreference ThemePreference @default(SYSTEM)

  marketingOptIn Boolean @default(false)

  timezone String @default("Asia/Kolkata")

  referralCode   String? @unique
  referredByCode String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions               Session[]
  restaurants            Restaurant[]
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  pushTokens             PushToken[]
  reviews                Review[]
  restaurantFavorites    RestaurantFavorite[]
  menuItemFavorites      MenuItemFavorite[]

  customerOrders Order[] @relation("CustomerOrders")
  deliveryOrders Order[] @relation("DeliveryOrders")

  deliveryPartnerProfile DeliveryPartner?

  addresses Address[]

  cart Cart?

  walletTransactions WalletTransaction[]
  referralsMade      Referral[]          @relation("ReferralsMade")
  referralReceived   Referral?           @relation("ReferralsReceived")
  recentSearches     RecentSearch[]
  couponRedemptions  CouponRedemption[]

  customerTickets   SupportTicket[]    @relation("CustomerTickets")
  assignedTickets   SupportTicket[]    @relation("AssignedTickets")
  ticketMessages    TicketMessage[]
  ticketAttachments TicketAttachment[]

  restaurantStaffMemberships RestaurantStaff[]

  passwordResetTokens PasswordResetToken[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

model Address {
  id String @id @default(uuid())

  customerId String

  label AddressLabel @default(HOME)

  customLabel String?

  addressLine1 String

  addressLine2 String?

  city String

  state String

  postalCode String

  landmark String?

  deliveryInstructions String?

  latitude Float?

  longitude Float?

  accuracy Float?

  altitude Float?

  heading Float?

  speed Float?

  locationSource LocationSource?

  provider MapProvider?

  providerPlaceId String?

  providerMetadata Json?

  verified Boolean @default(false)

  verifiedAt DateTime?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orders Order[]

  @@index([customerId])
  @@map("addresses")
}

model Cart {
  id String @id @default(uuid())

  customerId String @unique

  restaurantId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id String @id @default(uuid())

  cartId String

  menuItemId String

  variantId String?

  quantity Int

  specialInstructions String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  variant MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  addonOptions CartItemAddonOption[]

  @@index([cartId])
  @@index([menuItemId])
  @@map("cart_items")
}

model CartItemAddonOption {
  id String @id @default(uuid())

  cartItemId String

  addonOptionId String

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  addonOption MenuItemAddonOption @relation(fields: [addonOptionId], references: [id], onDelete: Cascade)

  @@index([cartItemId])
  @@map("cart_item_addon_options")
}

model Session {
  id String @id @default(uuid())

  userId String

  deviceName String?
  ipAddress  String?
  userAgent  String?

  isActive Boolean @default(true)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id String @id @default(uuid())

  userId String

  token String @unique

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

/**
 * Single-use, short-lived token for the forgot-password flow. Only the SHA-256 hash of the raw
 * token is ever stored (same pattern as RefreshToken) — the raw value exists only in the email
 * sent to the user and is never persisted. `usedAt` enforces single-use; a used or expired
 * token is rejected exactly like a missing one, without revealing which.
 */
model PasswordResetToken {
  id String @id @default(uuid())

  userId String

  tokenHash String @unique

  expiresAt DateTime

  usedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model OtpVerification {
  id String @id @default(uuid())

  phone String?
  email String?

  otpCode String

  expiresAt DateTime

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([email])
  @@map("otp_verifications")
}

model Restaurant {
  id String @id @default(uuid())

  ownerId String

  /**
   * Plain forward-compatible pointer — no Business aggregate/table exists yet. Reserved for a
   * future multi-restaurant Business entity so ownership never has to assume one owner owns
   * only one restaurant brand.
   */
  businessId String?

  name String

  /**
   * Registered legal name, distinct from the public-facing `name`/`brandName`.
   */
  legalBusinessName String?

  tradeName String?

  brandName String?

  slug String @unique

  description String?

  phone String?

  email String?

  supportEmail String?

  supportPhone String?

  businessEmail String?

  businessPhone String?

  website String?

  logoUrl String?

  bannerUrl String?

  status RestaurantStatus @default(PENDING)

  isActive Boolean @default(true)

  featured Boolean @default(false)

  avgRating Float @default(0)

  ratingCount Int @default(0)

  avgPreparationTimeMinutes Int?

  avgDeliveryTimeMinutes Int?

  deliveredOrderCount Int @default(0)

  /**
   * Derived from its menu items — recomputed by MenuRepository whenever an item's veg/vegan flag changes.
   */
  hasVegOptions   Boolean @default(false)
  hasVeganOptions Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  branches RestaurantBranch[]

  cuisines RestaurantCuisine[]

  menuCategories MenuCategory[]

  orders Order[]

  reviews Review[]

  offers Offer[]

  coupons Coupon[]

  carts Cart[]

  favoritedBy RestaurantFavorite[]

  staff RestaurantStaff[]

  verification RestaurantVerification?

  documents RestaurantDocument[]

  taxProfile RestaurantTaxProfile?

  bankAccount RestaurantBankAccount?

  media RestaurantMedia[]

  settings RestaurantSettings?

  holidays RestaurantHoliday[]

  onboarding RestaurantOnboarding?

  @@index([ownerId])
  @@index([businessId])
  @@index([status])
  @@index([featured])
  @@index([hasVegOptions])
  @@index([hasVeganOptions])
  @@map("restaurants")
}

model RestaurantBranch {
  id String @id @default(uuid())

  restaurantId String

  name String

  addressLine1 String

  addressLine2 String?

  city String

  state String

  postalCode String

  landmark String?

  latitude Float?

  longitude Float?

  timezone String?

  /**
   * Simple radius in kilometers for now — polygon/geofence support is future work.
   */
  deliveryRadiusKm Float?

  phone String?

  emergencyContactName String?

  emergencyContactPhone String?

  isActive Boolean @default(true)

  /**
   * Explicit "which branch is the default for legacy single-branch flows" flag — replaces the
   * implicit `branches[0]` assumption used throughout the platform prior to ERPH-1.
   */
  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  operatingHours OperatingHour[]
  orders         Order[]

  staff RestaurantStaff[]

  documents RestaurantDocument[]

  media RestaurantMedia[]

  menuCategories MenuCategory[]

  holidays RestaurantHoliday[]

  @@index([restaurantId])
  @@index([isPrimary])
  @@map("restaurant_branches")
}

model Cuisine {
  id String @id @default(uuid())

  name String @unique

  createdAt DateTime @default(now())

  restaurants RestaurantCuisine[]

  @@map("cuisines")
}

model RestaurantCuisine {
  restaurantId String

  cuisineId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  cuisine Cuisine @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@id([restaurantId, cuisineId])
  @@map("restaurant_cuisines")
}

model RestaurantStaff {
  id String @id @default(uuid())

  restaurantId String

  userId String

  /**
   * Null means "restaurant-wide" — e.g. OWNER/CO_OWNER/FINANCE_MANAGER typically aren't scoped
   * to one branch, while BRANCH_MANAGER/KITCHEN_MANAGER/STAFF usually are.
   */
  branchId String?

  role RestaurantStaffRole @default(STAFF)

  status RestaurantStaffStatus @default(INVITED)

  /**
   * Plain attribution field, not a Prisma relation — kept lightweight like other audit-only
   * references in this schema (see RestaurantDocument.uploadedById).
   */
  invitedById String?

  invitedAt DateTime @default(now())

  respondedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  branch RestaurantBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, userId])
  @@index([restaurantId])
  @@index([userId])
  @@index([branchId])
  @@map("restaurant_staff")
}

/**
 * Dedicated verification aggregate — deliberately separate from RestaurantStatus, which stays a
 * small, stable enum with existing consumers (public listing filter, admin 4-state chip). This
 * richer sub-state-machine feeds into RestaurantStatus rather than replacing it: a restaurant
 * only becomes RestaurantStatus.APPROVED once this reaches RestaurantVerificationStage.APPROVED.
 */
model RestaurantVerification {
  id String @id @default(uuid())

  restaurantId String @unique

  stage RestaurantVerificationStage @default(DRAFT)

  submittedAt DateTime?

  decidedAt DateTime?

  decidedById String?

  rejectedReason String?

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([stage])
  @@map("restaurant_verifications")
}

/**
 * One generic table for the long tail of document types (trade license, fire NOC, halal, etc.)
 * rather than N near-identical tables — new document types are an enum addition, not a
 * migration. GST/FSSAI/bank still get their canonical numbers and expiry dates as typed,
 * indexed columns on RestaurantTaxProfile/RestaurantBankAccount for cheap expiry queries; this
 * table holds the uploaded certificate/proof file for every document type, including GST/FSSAI.
 */
model RestaurantDocument {
  id String @id @default(uuid())

  restaurantId String

  branchId String?

  documentType RestaurantDocumentType

  documentNumber String?

  issueDate DateTime?

  expiryDate DateTime?

  status VerificationStatus @default(PENDING)

  storageUrl String

  fileName String

  mimeType String

  sizeBytes Int

  uploadedById String

  verifiedById String?

  verifiedAt DateTime?

  rejectedReason String?

  metadata Json?

  version Int @default(1)

  isLatest Boolean @default(true)

  /**
   * Plain attribution field pointing at the prior version's id — avoids a self-relation for a
   * simple linear version chain that's walked in application code, not via Prisma include.
   */
  previousVersionId String?

  deletedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  branch RestaurantBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([branchId])
  @@index([documentType])
  @@index([status])
  @@index([expiryDate])
  @@map("restaurant_documents")
}

model RestaurantTaxProfile {
  id String @id @default(uuid())

  restaurantId String @unique

  gstin String?

  gstLegalName String?

  gstRegisteredAddress String?

  gstBusinessCategory String?

  gstRegistrationState String?

  gstVerificationStatus VerificationStatus @default(PENDING)

  gstVerifiedById String?

  gstVerifiedAt DateTime?

  fssaiNumber String?

  fssaiLicenseType String?

  fssaiIssueDate DateTime?

  fssaiExpiryAt DateTime?

  fssaiVerificationStatus VerificationStatus @default(PENDING)

  fssaiVerifiedById String?

  fssaiVerifiedAt DateTime?

  pan String?

  cin String?

  businessType BusinessType?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([fssaiExpiryAt])
  @@map("restaurant_tax_profiles")
}

model RestaurantBankAccount {
  id String @id @default(uuid())

  restaurantId String @unique

  accountHolderName String

  bankName String

  branchName String?

  /**
   * AES-256-GCM ciphertext (iv + authTag + ciphertext, base64-joined) — see
   * shared/crypto/crypto.util.ts. The full number is never returned by any API response.
   */
  accountNumberEncrypted String

  accountNumberLast4 String

  ifsc String

  upiId String?

  /**
   * Plain reference to the RestaurantDocument row holding the uploaded cancelled cheque.
   */
  cancelledChequeDocumentId String?

  verificationStatus VerificationStatus @default(PENDING)

  verifiedById String?

  verifiedAt DateTime?

  /**
   * Reserved for a future payout integration (Razorpay Route / Cashfree Payouts).
   */
  payoutProviderRef String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_bank_accounts")
}

model RestaurantMedia {
  id String @id @default(uuid())

  restaurantId String

  branchId String?

  type RestaurantMediaType

  url String

  sortOrder Int @default(0)

  uploadedById String

  createdAt DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  branch RestaurantBranch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([restaurantId])
  @@index([branchId])
  @@index([type])
  @@map("restaurant_media")
}

model OperatingHour {
  id String @id @default(uuid())

  branchId String

  dayOfWeek Int

  opensAt String

  closesAt String

  isClosed Boolean @default(false)

  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  /**
   * Deliberately no unique constraint on [branchId, dayOfWeek] — split shifts (e.g. a lunch
   * window and a separate dinner window on the same day) are modeled as two rows sharing the
   * same dayOfWeek rather than a single row with multiple time ranges.
   */
  @@index([branchId])
  @@index([branchId, dayOfWeek])
  @@map("operating_hours")
}

/**
