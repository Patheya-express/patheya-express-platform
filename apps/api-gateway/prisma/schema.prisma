model Coupon {
  id String @id @default(uuid())

  code String @unique

  name String

  description String?

  type CouponType

  /**
   * Percentage points (e.g. 10 = 10%) for PERCENTAGE, a flat rupee amount for FLAT, ignored for FREE_DELIVERY.
   */
  value Decimal @db.Decimal(10, 2)

  /**
   * Caps the computed discount for PERCENTAGE coupons. Ignored for FLAT and FREE_DELIVERY.
   */
  maxDiscountAmount Decimal? @db.Decimal(10, 2)

  minOrderAmount Decimal @default(0) @db.Decimal(10, 2)

  scope CouponScope @default(PLATFORM)

  /**
   * Required when scope is RESTAURANT, ignored when scope is PLATFORM.
   */
  restaurantId String?

  /**
   * Total redemptions allowed across all customers. Null means unlimited.
   */
  usageLimit Int?

  /**
   * Redemptions allowed per individual customer.
   */
  usagePerUser Int @default(1)

  totalUsed Int @default(0)

  startsAt DateTime

  endsAt DateTime

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

