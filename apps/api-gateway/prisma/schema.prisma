generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  RESTAURANT_OWNER
  RESTAURANT_MANAGER
  DELIVERY_PARTNER
  SUPPORT_AGENT
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  BLOCKED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
  PHONE
}

enum ThemePreference {
  LIGHT
  DARK
  SYSTEM
}

enum RestaurantStatus {
  PENDING

  APPROVED

  REJECTED

  SUSPENDED
}

enum OrderStatus {
  PENDING

  CONFIRMED

  PREPARING

  READY_FOR_PICKUP

  OUT_FOR_DELIVERY

  DELIVERED

  CANCELLED
}

enum PaymentStatus {
  PENDING

  PAID

  FAILED

  REFUNDED
}

enum DeliveryPartnerStatus {
  OFFLINE

  AVAILABLE

  ON_DELIVERY

  SUSPENDED
}

enum VehicleType {
  BIKE

  SCOOTER

  BICYCLE

  CAR
}

enum AuditAction {
  CREATE

  UPDATE

  DELETE

  LOGIN

  LOGOUT

  STATUS_CHANGE

  APPROVE

  REJECT
}

enum NotificationType {
  ORDER_PLACED
  ORDER_STATUS_CHANGED
  DELIVERY_PARTNER_ASSIGNED
  OFFER
  WALLET_CREDIT
  REFERRAL_REWARD
  TICKET_STATUS_CHANGED
  TICKET_MESSAGE
  GENERAL
}

enum OfferType {
  PERCENTAGE_OFF
  FLAT_OFF
  FREE_DELIVERY
  BUY_ONE_GET_ONE
  CASHBACK
  OTHER
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  WHATSAPP
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum PaymentProvider {
  RAZORPAY

  STRIPE
}

enum PaymentMethod {
  UPI

  CARD

  NETBANKING

  WALLET

  COD
}

enum PaymentMode {
  ONLINE

  COD
}

enum AddressLabel {
  HOME

  WORK

  OTHER
}

enum TransactionStatus {
  PENDING

  SUCCESS

  FAILED

  REFUNDED
}

enum AssignmentStatus {
  PENDING

  ASSIGNED

  ACCEPTED

  REJECTED

  EXPIRED
}

enum WalletTransactionType {
  CASHBACK
  REFERRAL_REWARD
  REFUND_CREDIT
  ORDER_PAYMENT
  ADMIN_ADJUSTMENT
}

enum WalletTransactionStatus {
  COMPLETED
  REVERSED
}

enum ReferralStatus {
  PENDING
  REWARDED
}

enum TicketCategory {
  ORDER_ISSUE
  PAYMENT_ISSUE
  REFUND_REQUEST
  CANCELLATION_REQUEST
  ACCOUNT_ISSUE
  GENERAL
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CUSTOMER
  RESOLVED
  CLOSED
}

enum TicketMessageSenderType {
  CUSTOMER
  AGENT
  SYSTEM
}

model User {
  id String @id @default(uuid())

  firstName String
  lastName  String?

  email String? @unique
  phone String? @unique

  passwordHash String?

  role   UserRole
  status UserStatus @default(ACTIVE)

  provider AuthProvider @default(EMAIL)

  isEmailVerified Boolean @default(false)
  isPhoneVerified Boolean @default(false)

  lastLoginAt DateTime?

  avatarUrl String?

  preferredLanguage String @default("en")

  themePreference ThemePreference @default(SYSTEM)

  marketingOptIn Boolean @default(false)

  timezone String @default("Asia/Kolkata")

  referralCode    String? @unique
  referredByCode  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  sessions               Session[]
  restaurants            Restaurant[]
  refreshTokens          RefreshToken[]
  auditLogs              AuditLog[]
  notifications          Notification[]
  notificationPreference NotificationPreference?
  pushTokens             PushToken[]
  reviews                Review[]
  restaurantFavorites    RestaurantFavorite[]
  menuItemFavorites      MenuItemFavorite[]

  customerOrders Order[] @relation("CustomerOrders")
  deliveryOrders Order[] @relation("DeliveryOrders")

  deliveryPartnerProfile DeliveryPartner?

  addresses Address[]

  cart Cart?

  walletTransactions WalletTransaction[]
  referralsMade      Referral[]           @relation("ReferralsMade")
  referralReceived   Referral?            @relation("ReferralsReceived")
  recentSearches     RecentSearch[]

  customerTickets    SupportTicket[] @relation("CustomerTickets")
  assignedTickets    SupportTicket[] @relation("AssignedTickets")
  ticketMessages     TicketMessage[]
  ticketAttachments  TicketAttachment[]

  @@index([email])
  @@index([phone])
  @@index([role])
  @@map("users")
}

model Address {
  id String @id @default(uuid())

  customerId String

  label AddressLabel @default(HOME)

  customLabel String?

  addressLine1 String

  addressLine2 String?

  city String

  state String

  postalCode String

  landmark String?

  deliveryInstructions String?

  latitude Float?

  longitude Float?

  isDefault Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  orders Order[]

  @@index([customerId])
  @@map("addresses")
}

model Cart {
  id String @id @default(uuid())

  customerId String @unique

  restaurantId String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id])

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id String @id @default(uuid())

  cartId String

  menuItemId String

  variantId String?

  quantity Int

  specialInstructions String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  cart Cart @relation(fields: [cartId], references: [id], onDelete: Cascade)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  variant MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  addonOptions CartItemAddonOption[]

  @@index([cartId])
  @@index([menuItemId])
  @@map("cart_items")
}

model CartItemAddonOption {
  id String @id @default(uuid())

  cartItemId String

  addonOptionId String

  cartItem CartItem @relation(fields: [cartItemId], references: [id], onDelete: Cascade)

  addonOption MenuItemAddonOption @relation(fields: [addonOptionId], references: [id], onDelete: Cascade)

  @@index([cartItemId])
  @@map("cart_item_addon_options")
}

model Session {
  id String @id @default(uuid())

  userId String

  deviceName String?
  ipAddress  String?
  userAgent  String?

  isActive Boolean @default(true)

  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model RefreshToken {
  id String @id @default(uuid())

  userId String

  token String @unique

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpVerification {
  id String @id @default(uuid())

  phone String?
  email String?

  otpCode String

  expiresAt DateTime

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([phone])
  @@index([email])
  @@map("otp_verifications")
}

model Restaurant {
  id String @id @default(uuid())

  ownerId String

  name String

  slug String @unique

  description String?

  phone String?

  email String?

  logoUrl String?

  bannerUrl String?

  status RestaurantStatus @default(PENDING)

  isActive Boolean @default(true)

  featured Boolean @default(false)

  avgRating Float @default(0)

  ratingCount Int @default(0)

  avgPreparationTimeMinutes Int?

  avgDeliveryTimeMinutes Int?

  deliveredOrderCount Int @default(0)

  /** Derived from its menu items — recomputed by MenuRepository whenever an item's veg/vegan flag changes. */
  hasVegOptions   Boolean @default(false)
  hasVeganOptions Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  branches RestaurantBranch[]

  cuisines RestaurantCuisine[]

  menuCategories MenuCategory[]

  orders Order[]

  reviews Review[]

  offers Offer[]

  carts Cart[]

  favoritedBy RestaurantFavorite[]

  @@index([ownerId])
  @@index([status])
  @@index([featured])
  @@index([hasVegOptions])
  @@index([hasVeganOptions])
  @@map("restaurants")
}

model RestaurantBranch {
  id String @id @default(uuid())

  restaurantId String

  name String

  addressLine1 String

  addressLine2 String?

  city String

  state String

  postalCode String

  latitude Float?

  longitude Float?

  phone String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  operatingHours OperatingHour[]
  orders         Order[]

  @@index([restaurantId])
  @@map("restaurant_branches")
}

model Cuisine {
  id String @id @default(uuid())

  name String @unique

  createdAt DateTime @default(now())

  restaurants RestaurantCuisine[]

  @@map("cuisines")
}

model RestaurantCuisine {
  restaurantId String

  cuisineId String

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  cuisine Cuisine @relation(fields: [cuisineId], references: [id], onDelete: Cascade)

  @@id([restaurantId, cuisineId])
  @@map("restaurant_cuisines")
}

model OperatingHour {
  id String @id @default(uuid())

  branchId String

  dayOfWeek Int

  opensAt String

  closesAt String

  isClosed Boolean @default(false)

  branch RestaurantBranch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@map("operating_hours")
}

model Review {
  id String @id @default(uuid())

  restaurantId String

  customerId String

  rating Int

  comment String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, customerId])
  @@index([restaurantId])
  @@map("reviews")
}

model RestaurantFavorite {
  id String @id @default(uuid())

  customerId String

  restaurantId String

  createdAt DateTime @default(now())

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([customerId, restaurantId])
  @@index([restaurantId])
  @@map("restaurant_favorites")
}

model MenuItemFavorite {
  id String @id @default(uuid())

  customerId String

  menuItemId String

  createdAt DateTime @default(now())

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([customerId, menuItemId])
  @@index([menuItemId])
  @@map("menu_item_favorites")
}

model Offer {
  id String @id @default(uuid())

  restaurantId String?

  title String

  description String?

  imageUrl String?

  linkUrl String?

  type OfferType?

  isActive Boolean @default(true)

  startsAt DateTime?

  endsAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@index([restaurantId])
  @@index([isActive])
  @@index([type])
  @@map("offers")
}

model MenuCategory {
  id String @id @default(uuid())

  restaurantId String

  name String

  description String?

  sortOrder Int @default(0)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  menuItems MenuItem[]

  @@index([restaurantId])
  @@map("menu_categories")
}

model MenuItem {
  id String @id @default(uuid())

  categoryId String

  name String

  description String?

  imageUrl String?

  basePrice Decimal @db.Decimal(10, 2)

  isVegetarian Boolean @default(false)

  isVegan Boolean @default(false)

  isAvailable Boolean @default(true)

  preparationTime Int?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  variants MenuItemVariant[]

  addons MenuItemAddon[]

  orderItems OrderItem[]

  cartItems CartItem[]

  favoritedBy MenuItemFavorite[]

  @@index([categoryId])
  @@map("menu_items")
}

model MenuItemVariant {
  id String @id @default(uuid())

  menuItemId String

  name String

  price Decimal @db.Decimal(10, 2)

  isDefault Boolean @default(false)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  orderItems OrderItem[]

  cartItems CartItem[]

  @@index([menuItemId])
  @@map("menu_item_variants")
}

model MenuItemAddon {
  id String @id @default(uuid())

  menuItemId String

  name String

  minSelection Int @default(0)

  maxSelection Int @default(1)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  options MenuItemAddonOption[]

  @@index([menuItemId])
  @@map("menu_item_addons")
}

model MenuItemAddonOption {
  id String @id @default(uuid())

  addonId String

  name String

  price Decimal @db.Decimal(10, 2)

  isAvailable Boolean @default(true)

  addon MenuItemAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  orderItemAddonOptions OrderItemAddonOption[]

  cartItemAddonOptions CartItemAddonOption[]

  @@index([addonId])
  @@map("menu_item_addon_options")
}

model Order {
  id String @id @default(uuid())

  customerId String

  restaurantId String

  branchId String?

  deliveryPartnerId String?

  payment Payment[]

  orderNumber String @unique

  status OrderStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING)

  paymentMode PaymentMode @default(ONLINE)

  addressId String?

  subtotalAmount Decimal @db.Decimal(10, 2)

  deliveryFee Decimal @db.Decimal(10, 2)

  taxAmount Decimal @db.Decimal(10, 2)

  totalAmount Decimal @db.Decimal(10, 2)

  /** Portion of totalAmount paid via wallet balance; the remainder is charged via the provider Payment(s) above. */
  walletAmountUsed Decimal @db.Decimal(10, 2) @default(0)

  notes String?

  deliveryAddress String

  latitude Float?

  longitude Float?

  placedAt DateTime @default(now())

  deliveredAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  customer User @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  branch RestaurantBranch? @relation(fields: [branchId], references: [id])

  deliveryPartner User? @relation("DeliveryOrders", fields: [deliveryPartnerId], references: [id])

  address Address? @relation(fields: [addressId], references: [id])

  items OrderItem[]

  statusHistory OrderStatusHistory[]

  deliveryAssignments DeliveryAssignment[]

  walletTransactions WalletTransaction[]

  supportTickets SupportTicket[]

  @@index([customerId])
  @@index([restaurantId])
  @@index([status])
  @@index([paymentStatus])
  @@map("orders")
}

model OrderItem {
  id String @id @default(uuid())

  orderId String

  menuItemId String

  variantId String?

  quantity Int

  unitPrice Decimal @db.Decimal(10, 2)

  totalPrice Decimal @db.Decimal(10, 2)

  specialInstructions String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  variant MenuItemVariant? @relation(fields: [variantId], references: [id])

  addonOptions OrderItemAddonOption[]

  @@index([orderId])
  @@index([menuItemId])
  @@map("order_items")
}

model OrderItemAddonOption {
  id String @id @default(uuid())

  orderItemId String

  addonOptionId String

  name String

  price Decimal @db.Decimal(10, 2)

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  addonOption MenuItemAddonOption @relation(fields: [addonOptionId], references: [id])

  @@index([orderItemId])
  @@map("order_item_addon_options")
}

model OrderStatusHistory {
  id String @id @default(uuid())

  orderId String

  status OrderStatus

  note String?

  createdAt DateTime @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("order_status_history")
}

model DeliveryPartner {
  id String @id @default(uuid())

  userId String @unique

  vehicleType VehicleType

  vehicleNumber String

  licenseNumber String?

  status DeliveryPartnerStatus @default(OFFLINE)

  currentLatitude Float?

  currentLongitude Float?

  isVerified Boolean @default(false)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  assignments DeliveryAssignment[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("delivery_partners")
}

model AuditLog {
  id String @id @default(uuid())

  userId String?

  entityType String

  entityId String?

  action AuditAction

  oldValues Json?

  newValues Json?

  ipAddress String?

  userAgent String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id String @id @default(uuid())

  userId String

  type NotificationType @default(GENERAL)

  title String

  message String

  channel NotificationChannel

  status NotificationStatus @default(PENDING)

  metadata Json?

  attempts Int @default(0)

  errorMessage String?

  sentAt DateTime?

  readAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([channel])
  @@index([type])
  @@map("notifications")
}

model NotificationPreference {
  id String @id @default(uuid())

  userId String @unique

  emailEnabled Boolean @default(true)

  smsEnabled Boolean @default(true)

  pushEnabled Boolean @default(true)

  whatsappEnabled Boolean @default(true)

  inAppEnabled Boolean @default(true)

  orderUpdatesEmail Boolean @default(true)

  orderUpdatesSms Boolean @default(true)

  orderUpdatesPush Boolean @default(true)

  promotionsEmail Boolean @default(false)

  promotionsSms Boolean @default(false)

  promotionsPush Boolean @default(false)

  reviewsEmail Boolean @default(true)

  reviewsSms Boolean @default(false)

  reviewsPush Boolean @default(true)

  systemEmail Boolean @default(true)

  systemSms Boolean @default(false)

  systemPush Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PushToken {
  id String @id @default(uuid())

  userId String

  token String @unique

  platform String

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_tokens")
}

model Payment {
  id String @id @default(uuid())

  orderId String

  provider PaymentProvider

  providerOrderId String? @unique

  providerPaymentId String?

  amount Decimal @db.Decimal(10, 2)

  status TransactionStatus @default(PENDING)

  method PaymentMethod?

  attemptNumber Int @default(1)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  refunds Refund[]

  supportTickets SupportTicket[]

  @@index([orderId])
  @@index([status])
  @@index([provider])
  @@index([isActive])
  @@index([attemptNumber])
  @@map("payments")
}

model Refund {
  id String @id @default(uuid())

  paymentId String

  amount Decimal @db.Decimal(10, 2)

  reason String?

  status TransactionStatus @default(PENDING)

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

model WebhookEvent {
  id String @id @default(uuid())

  provider String

  eventType String

  payload Json

  processed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([provider])
  @@index([processed])
  @@map("webhook_events")
}

model DeliveryAssignment {
  id String @id @default(uuid())

  orderId String

  deliveryPartnerId String

  status AssignmentStatus @default(PENDING)

  assignedAt DateTime @default(now())

  respondedAt DateTime?

  expiresAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  deliveryPartner DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([deliveryPartnerId])
  @@index([status])
  @@map("delivery_assignments")
}

// ---------------------------------------------------------------------------
// C7 — Search, Filters & Discovery
// ---------------------------------------------------------------------------

/** Per-customer recent search terms, most-recent-first. Upserted on (customerId, query) so a repeated search bumps to the top instead of duplicating. */
model RecentSearch {
  id String @id @default(uuid())

  customerId String
  query      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, query])
  @@index([customerId, updatedAt])
  @@map("recent_searches")
}

/** Append-only log of every search query (including anonymous/guest ones) — the raw input the trending-search aggregation job reads from. */
model SearchLog {
  id String @id @default(uuid())

  query      String
  customerId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([query])
  @@map("search_logs")
}

/** Precomputed by the trending-search BullMQ job — read directly by the public trending-searches endpoint so it never aggregates on the request path. */
model TrendingSearch {
  id String @id @default(uuid())

  query String @unique
  score Int    @default(0)

  updatedAt DateTime @updatedAt

  @@index([score])
  @@map("trending_searches")
}

// ---------------------------------------------------------------------------
// C9 — Wallet, Loyalty & Referral
// ---------------------------------------------------------------------------

/** Immutable, append-only ledger — a user's wallet balance is always the SUM of their COMPLETED transactions, never a mutable counter. */
model WalletTransaction {
  id String @id @default(uuid())

  userId String
  type   WalletTransactionType
  status WalletTransactionStatus @default(COMPLETED)

  /** Positive = credit, negative = debit. */
  amount Decimal @db.Decimal(10, 2)

  /** Snapshot of the running balance immediately after this entry — written once at insert time for fast history display, never updated afterwards. */
  balanceAfter Decimal @db.Decimal(10, 2)

  orderId    String?
  referralId String?

  description String

  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id])
  referral Referral? @relation(fields: [referralId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([type])
  @@map("wallet_transactions")
}

/** One row per referred user (refereeId is unique — a user can only ever be referred once). Rewarded when the referee's first order reaches DELIVERED. */
model Referral {
  id String @id @default(uuid())

  referrerId String
  refereeId  String @unique

  status       ReferralStatus @default(PENDING)
  rewardAmount Decimal?       @db.Decimal(10, 2)
  rewardedAt   DateTime?

  createdAt DateTime @default(now())

  referrer           User                @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referee            User                @relation("ReferralsReceived", fields: [refereeId], references: [id], onDelete: Cascade)
  walletTransactions WalletTransaction[]

  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

// ---------------------------------------------------------------------------
// C14 — Customer Help & Support
// ---------------------------------------------------------------------------

model SupportTicket {
  id           String @id @default(uuid())
  ticketNumber String @unique

  customerId      String
  assignedAgentId String?

  orderId   String?
  paymentId String?

  category TicketCategory
  priority TicketPriority @default(MEDIUM)
  status   TicketStatus   @default(OPEN)

  subject     String
  description String

  firstResponseAt DateTime?
  resolvedAt      DateTime?
  escalatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      User    @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)
  assignedAgent User?   @relation("AssignedTickets", fields: [assignedAgentId], references: [id])
  order         Order?  @relation(fields: [orderId], references: [id])
  payment       Payment? @relation(fields: [paymentId], references: [id])

  messages    TicketMessage[]
  attachments TicketAttachment[]

  @@index([customerId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([priority])
  @@index([orderId])
  @@map("support_tickets")
}

model TicketMessage {
  id String @id @default(uuid())

  ticketId   String
  senderId   String?
  senderType TicketMessageSenderType

  message String

  createdAt DateTime @default(now())

  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User?              @relation(fields: [senderId], references: [id])
  attachments TicketAttachment[]

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketAttachment {
  id String @id @default(uuid())

  ticketId     String
  messageId    String?
  uploadedById String

  fileUrl   String
  fileName  String
  mimeType  String
  sizeBytes Int

  createdAt DateTime @default(now())

  ticket     SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy User           @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@map("ticket_attachments")
}

model FAQ {
  id String @id @default(uuid())

  category String
  question String
  answer   String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("faqs")
}
