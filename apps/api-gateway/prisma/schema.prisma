  @@map("coupons")
}

/**
 * One row per order a coupon was actually applied to — the ledger `CouponsService` reads to
 * enforce usageLimit/usagePerUser and that OrdersService writes exactly once per order at
 * placement time. `orderId` is unique: a single order can redeem at most one coupon.
 */
model CouponRedemption {
  id String @id @default(uuid())

  couponId String

  userId String

  /**
   * Nullable (Sprint 1.3): CouponsRepository.reserveRedemption inserts this row immediately,
   * atomically alongside claiming the usage slot — BEFORE the order it belongs to exists — so
   * that a concurrent reservation attempt by the same user genuinely has something to count
   * against (closes a per-user race that a later-created row couldn't; see that method's doc
   * comment). `orderId` is filled in once the order is actually created
   * (OrdersService.placeOrderInternal -> CouponsService.finalizeRedemption). A row that never
   * gets linked (the order attempt it was reserved for failed or lost an idempotency race) is
   * deleted by releaseRedemption rather than left with a null orderId. Still unique when set —
   * Postgres treats multiple NULLs as distinct, so any number of not-yet-linked rows can coexist
   * without colliding on this constraint.
   */
  orderId String? @unique

  discountAmount Decimal @db.Decimal(10, 2)

  redeemedAt DateTime @default(now())

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  order Order? @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([couponId, userId])
  @@map("coupon_redemptions")
}

