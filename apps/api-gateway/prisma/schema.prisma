}

/**
 * ERPH-2B.1 — the mandatory onboarding wizard's own progress record, one per restaurant.
 * Created lazily (findOrCreate, same pattern as RestaurantSettings) the moment a restaurant is
 * created (see OnboardingRestaurantCreatedListener), and is the single source of truth
 * OnboardingGuard reads to decide whether the owner may reach the operational app at all.
 */
model RestaurantOnboarding {
  id String @id @default(uuid())

  restaurantId String @unique

  status OnboardingStatus @default(DRAFT)

  /**
   * 1-12, matching the wizard step order (Business Details .. Review). Not itself the
   * completion signal — see completedSteps — just where the wizard should resume.
   */
  currentStep Int @default(1)

  /**
   * Which of steps 1-12 have been marked complete. A Postgres int array rather than a join
   * table — this is a small, append-only set with no per-step metadata beyond "done or not".
   */
  completedSteps Int[] @default([])

  termsAcceptedAt DateTime?

  submittedAt DateTime?

  decidedAt DateTime?

  /**
   * Set by the admin "Request Changes" action — an array of { section, reason } objects
   * identifying exactly which wizard sections need correction. No equivalent concept exists on
