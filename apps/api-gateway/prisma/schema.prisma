model Order {
  id String @id @default(uuid())

  customerId String

  restaurantId String

  branchId String?

  deliveryPartnerId String?

  payment Payment[]

  orderNumber String @unique

  /**
   * Client-generated UUID, one per checkout attempt (retried on failure, regenerated after
   * success) — see OrdersService.placeOrder. Scoped per-customer rather than globally unique so
   * two different customers can never collide even in the astronomically unlikely case of a
   * non-random client. This unique index is the actual concurrency-safety mechanism for
   * duplicate-order prevention: Postgres guarantees at most one row can ever exist for a given
   * (customerId, idempotencyKey) pair, independent of any application-level locking.
   */
  idempotencyKey String?

  status OrderStatus @default(PENDING)

  paymentStatus PaymentStatus @default(PENDING)

  paymentMode PaymentMode @default(ONLINE)

