model Refund {
  id String @id @default(uuid())

  paymentId String

  amount Decimal @db.Decimal(10, 2)

  reason String?

  status TransactionStatus @default(PENDING)

  createdAt DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId])
  @@map("refunds")
}

model WebhookEvent {
  id String @id @default(uuid())

  provider String

  eventType String

  payload Json

  processed Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([provider])
  @@index([processed])
  @@map("webhook_events")
}

model DeliveryAssignment {
  id String @id @default(uuid())

  orderId String

  deliveryPartnerId String

  status AssignmentStatus @default(PENDING)

  assignedAt DateTime @default(now())

  respondedAt DateTime?

  expiresAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  deliveryPartner DeliveryPartner @relation(fields: [deliveryPartnerId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([deliveryPartnerId])
  @@index([status])
  @@map("delivery_assignments")
}

enum DeliveryProofType {
  PICKUP
  DELIVERY
}

enum DeliveryProofOtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  EXCEEDED
}

/**
 * One row per (orderId, type) — Sprint 4.1. Generating (or regenerating) an OTP overwrites the
 * existing row in place rather than appending a new one, mirroring the singleton-per-owner
 * pattern already used by DeliveryBankAccount/DeliveryComplianceSnapshot; history of the action
 * itself is captured via AuditService.log, not by keeping old OTP rows around. `otpHash` is
 * bcrypt-hashed, never the raw 6-digit code, so a DB read alone can't recover it.
 */
model DeliveryProofOtp {
  id String @id @default(uuid())

  orderId String

  type DeliveryProofType

  otpHash String

  status DeliveryProofOtpStatus @default(PENDING)

  attempts Int @default(0)

  maxAttempts Int @default(5)

  expiresAt DateTime

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, type])
  @@map("delivery_proof_otps")
}

// ---------------------------------------------------------------------------
// C7 — Search, Filters & Discovery
// ---------------------------------------------------------------------------

/**
 * Per-customer recent search terms, most-recent-first. Upserted on (customerId, query) so a repeated search bumps to the top instead of duplicating.
 */
model RecentSearch {
  id String @id @default(uuid())

  customerId String
  query      String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer User @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, query])
  @@index([customerId, updatedAt])
  @@map("recent_searches")
}

/**
 * Append-only log of every search query (including anonymous/guest ones) — the raw input the trending-search aggregation job reads from.
 */
model SearchLog {
  id String @id @default(uuid())

  query      String
  customerId String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([query])
  @@map("search_logs")
}

/**
 * Precomputed by the trending-search BullMQ job — read directly by the public trending-searches endpoint so it never aggregates on the request path.
 */
model TrendingSearch {
  id String @id @default(uuid())

  query String @unique
  score Int    @default(0)

  updatedAt DateTime @updatedAt

  @@index([score])
  @@map("trending_searches")
}

// ---------------------------------------------------------------------------
// C9 — Wallet, Loyalty & Referral
// ---------------------------------------------------------------------------

/**
 * Immutable, append-only ledger — a user's wallet balance is always the SUM of their COMPLETED transactions, never a mutable counter.
 */
model WalletTransaction {
  id String @id @default(uuid())

  userId String
  type   WalletTransactionType
  status WalletTransactionStatus @default(COMPLETED)

  /**
   * Positive = credit, negative = debit.
   */
  amount Decimal @db.Decimal(10, 2)

  /**
   * Snapshot of the running balance immediately after this entry — written once at insert time for fast history display, never updated afterwards.
   */
  balanceAfter Decimal @db.Decimal(10, 2)

  orderId    String?
  referralId String?

  description String

  createdAt DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  order    Order?    @relation(fields: [orderId], references: [id])
  referral Referral? @relation(fields: [referralId], references: [id])

  @@index([userId])
  @@index([userId, createdAt])
  @@index([orderId])
  @@index([type])
  @@map("wallet_transactions")
}

/**
 * One row per referred user (refereeId is unique — a user can only ever be referred once). Rewarded when the referee's first order reaches DELIVERED.
 */
model Referral {
  id String @id @default(uuid())

  referrerId String
  refereeId  String @unique

  status       ReferralStatus @default(PENDING)
  rewardAmount Decimal?       @db.Decimal(10, 2)
  rewardedAt   DateTime?

  createdAt DateTime @default(now())

  referrer           User                @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  referee            User                @relation("ReferralsReceived", fields: [refereeId], references: [id], onDelete: Cascade)
  walletTransactions WalletTransaction[]

  @@index([referrerId])
  @@index([status])
  @@map("referrals")
}

// ---------------------------------------------------------------------------
// C14 — Customer Help & Support
// ---------------------------------------------------------------------------

model SupportTicket {
  id           String @id @default(uuid())
  ticketNumber String @unique

  customerId      String
  assignedAgentId String?

  orderId   String?
  paymentId String?

  category TicketCategory
  priority TicketPriority @default(MEDIUM)
  status   TicketStatus   @default(OPEN)

  subject     String
  description String

  firstResponseAt DateTime?
  resolvedAt      DateTime?
  escalatedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  customer      User     @relation("CustomerTickets", fields: [customerId], references: [id], onDelete: Cascade)
  assignedAgent User?    @relation("AssignedTickets", fields: [assignedAgentId], references: [id])
  order         Order?   @relation(fields: [orderId], references: [id])
  payment       Payment? @relation(fields: [paymentId], references: [id])

  messages    TicketMessage[]
  attachments TicketAttachment[]

  @@index([customerId])
  @@index([assignedAgentId])
  @@index([status])
  @@index([priority])
  @@index([orderId])
  @@map("support_tickets")
}

model TicketMessage {
  id String @id @default(uuid())

  ticketId   String
  senderId   String?
  senderType TicketMessageSenderType

  message String

  createdAt DateTime @default(now())

  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender      User?              @relation(fields: [senderId], references: [id])
  attachments TicketAttachment[]

  @@index([ticketId])
  @@index([ticketId, createdAt])
  @@map("ticket_messages")
}

model TicketAttachment {
  id String @id @default(uuid())

  ticketId     String
  messageId    String?
  uploadedById String

  fileUrl   String
  fileName  String
  mimeType  String
  sizeBytes Int

  createdAt DateTime @default(now())

  ticket     SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  message    TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  uploadedBy User           @relation(fields: [uploadedById], references: [id])

  @@index([ticketId])
  @@map("ticket_attachments")
}

model FAQ {
  id String @id @default(uuid())

  category String
  question String
  answer   String

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@map("faqs")
}
