# Placeholder values ONLY — consumed by `secretGenerator` in kustomization.yaml so `kubectl
# kustomize`/`kubectl apply -k` work out of the box for review/dry-run purposes. Real
# deployments MUST override this: create k8s/overlays/<env>/secret.env (gitignored, never
# committed — see the repo .gitignore's `**/.env.*` rule, which also matches this) with real
# values, and add a secretGenerator override in that overlay's kustomization.yaml, or use your
# cluster's secret manager (sealed-secrets, external-secrets, Vault, etc.) instead of a plain
# Kustomize secretGenerator entirely.
DATABASE_URL=postgresql://CHANGE_ME:CHANGE_ME@CHANGE_ME:5432/patheya_express_db?schema=public
JWT_ACCESS_SECRET=CHANGE_ME_long_random_value
JWT_REFRESH_SECRET=CHANGE_ME_different_long_random_value
CLOUDINARY_API_KEY=CHANGE_ME
CLOUDINARY_API_SECRET=CHANGE_ME
BANK_ACCOUNT_ENCRYPTION_KEY=CHANGE_ME_32byte_base64_key
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
SMTP_USER=CHANGE_ME
SMTP_PASS=CHANGE_ME
