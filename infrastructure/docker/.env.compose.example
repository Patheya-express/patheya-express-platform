# Compose-level variables — copy to `.env.compose` in this same directory
# (infrastructure/docker/.env.compose, already gitignored via the repo's `.env*` rule). Deliberately
# not named `.env` — every `docker compose` invocation must pass `--env-file
# infrastructure/docker/.env.compose` explicitly (see docker-compose.yml's own top comment) rather
# than relying on Compose's same-directory `.env` auto-discovery. Every variable below already has
# a working default baked into docker-compose.yml, so this file only needs entries you actually
# want to override — EXCEPT JWT_ACCESS_SECRET/JWT_REFRESH_SECRET below, whose shipped values are
# placeholders that must be replaced with real generated secrets before api-gateway will boot (the
# frontend repo's `pnpm run setup`/`pnpm run dev` do this for you automatically; see its
# `tools/dev/DEVELOPMENT.md`).
#
# This is separate from apps/api-gateway/.env — that one is for running the app natively
# (scripts/start-dev.ps1); this one is for running it via `docker compose`.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=patheya_express_db
# Host-published port only — the container always listens on 5432 internally, and api-gateway
# always reaches it at postgres:5432 regardless of this value. Default is 15432 (not 5432) so this
# doesn't race a native PostgreSQL install that already owns 5432 on your machine.
POSTGRES_PORT=15432

# --- Redis ---
REDIS_PORT=6379

# --- api-gateway ---
API_PORT=3000
NODE_ENV=development
LOG_TO_FILE=true
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
STORAGE_DRIVER=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# RazorpayProvider constructs the SDK client unconditionally at boot (see docs/infrastructure/README.md)
# — docker-compose.yml already supplies dev-mode placeholders if these are left unset.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
CUSTOMER_APP_URL=http://localhost:4200
RESTAURANT_APP_URL=http://localhost:4201
ADMIN_APP_URL=http://localhost:4202
DELIVERY_APP_URL=http://localhost:4203
