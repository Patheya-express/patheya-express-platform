# Compose-level variables — copy to `.env` in this same directory (infrastructure/docker/.env,
# already gitignored via the repo's `.env*` rule) so `docker compose` picks it up automatically.
# Every variable below already has a working default baked into docker-compose.yml, so this file
# only needs entries you actually want to override.
#
# This is separate from apps/api-gateway/.env — that one is for running the app natively
# (scripts/start-dev.ps1); this one is for running it via `docker compose`.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=patheya_express_db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- api-gateway ---
API_PORT=3000
NODE_ENV=development
LOG_TO_FILE=true
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
STORAGE_DRIVER=local
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# RazorpayProvider constructs the SDK client unconditionally at boot (see docs/infrastructure/README.md)
# — docker-compose.yml already supplies dev-mode placeholders if these are left unset.
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
CUSTOMER_APP_URL=http://localhost:4200
RESTAURANT_APP_URL=http://localhost:4201
ADMIN_APP_URL=http://localhost:4202
DELIVERY_APP_URL=http://localhost:4203
